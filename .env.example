# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable ("anon") key — safe in the browser, RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret ("service_role") key — SERVER ONLY. Bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudinary — https://console.cloudinary.com/settings/api-keys
# Used for question images and school/student photos.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned preset is not used: uploads are signed by /api/cloudinary/sign.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=permix

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute origin, used for auth redirects (password reset, email confirm).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
